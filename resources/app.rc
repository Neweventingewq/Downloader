// Windows resource file — sets the application icon and version metadata
// embedded in the compiled .exe.  The CMake build only picks this up on
// WIN32 (see CMakeLists.txt).

IDI_ICON1 ICON DISCARDABLE "icons/app.ico"

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Volchay"
            VALUE "FileDescription",  "Volchay Downloader"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "Volchay-Downloader"
            VALUE "OriginalFilename", "Volchay-Downloader.exe"
            VALUE "ProductName",      "Volchay Downloader"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
